generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Listing {
  id                 Int      @id @default(autoincrement())
  title              String
  url                String   @unique
  source             String   @default("adresowo.pl")
  propertyType       String?
  transactionType    String?
  marketType         String?
  location           String?
  price              Float?
  priceMin           Float?
  priceMax           Float?
  pricePerSqm        Float?
  sizeSqm            Float?
  surfaceMinSqm      Float?
  surfaceMaxSqm      Float?
  plotSizeSqm        Float?
  constructionYear   Int?
  rooms              Int?
  roomsMin           Int?
  roomsMax           Int?
  floor              String?
  houseType          String?
  submissionDeadline String?
  imageUrl           String?
  rawDescription     String   @db.Text
  rawAttributes      Json?
  scrapedAt          DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
