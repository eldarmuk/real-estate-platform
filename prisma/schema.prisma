generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Listing {
  id             Int      @id @default(autoincrement())
  title          String
  url            String   @unique
  price          Float?   
  sizeSqm        Float?   
  location       String?  
  rawDescription String   @db.Text 
  createdAt      DateTime @default(now())
}